# Copy this file to `.env` (in this same folder) and fill in real values.
# `.env` is gitignored — NEVER commit secrets.
#
# Usage:
#   cp .env.example .env
#   # then edit .env and paste your OpenAI key

# --- OpenAI API ---
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# gpt-5.5 with reasoning_effort tiers per use case (defaults set in config.py).
# One model only — no separate "fast/deep" split. Tune tiers per agent in code.
OPENAI_MODEL=gpt-5.5

# Hard ceiling on output tokens per LLM call (defense against runaway responses).
# 2000 covers our longest expected output (Counter-Perspective steelman).
OPENAI_MAX_OUTPUT_TOKENS=2000

# --- Budget guard ---
# Reject any LLM call estimated to cost more than this (single-call safety net).
PER_CALL_MAX_USD=0.30
# Hard daily ceiling. Reset at UTC midnight. $80 leaves $20 buffer on $100 credit.
PER_DAY_MAX_USD=80.00
# Log a warning when daily spend reaches this fraction of the cap.
COST_WARNING_THRESHOLD_PCT=0.80

# --- Chroma (vector DB, local embedded mode) ---
CHROMA_DIR=./data/chroma_index

# --- Reasoning state cache (disk-backed) ---
# Used to (1) pre-warm demo content, (2) fallback when budget exceeded,
# (3) avoid re-analyzing identical content within a session.
REASONING_CACHE_DIR=./data/reasoning_cache

# --- Server ---
LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
ENV=dev            # dev | prod
PORT=8000

# --- CORS ---
# Comma-separated list of origins. Demo site (Vite dev) + Vercel + extension (Path B).
# Override after first Vercel deploy with the actual production URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://freewall-demo.vercel.app

# --- Mock vs live agents (decision #18) ---
# True = orchestrator returns canned findings (pre-build / dev). False = real Runner.run.
USE_MOCK_AGENTS=true
